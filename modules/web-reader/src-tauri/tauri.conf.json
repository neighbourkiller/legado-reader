{
  "productName": "legado-reader",
  "identifier": "io.legado.reader",
  "version": "1.26.9010",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Legado Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "desktopTemplate": "desktop/legado-reader.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "desktop/legado-reader.desktop.hbs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
