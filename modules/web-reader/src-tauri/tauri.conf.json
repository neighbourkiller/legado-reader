{
  "productName": "Legado Reader",
  "identifier": "io.legado.reader",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:desktop-ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Legado Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
